{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "csv",
      "camelcase": "CSV",
      "title": "CSV",
      "scope": "source.csv",
      "file-types": [
        "csv"
      ],
      "injection-regex": "^csv$",
      "class-name": "TreeSitterCSV"
    }
  ],
  "metadata": {
    "version": "2.0.0",
    "license": "MIT",
    "description": "for syntax highlighting",
    "authors": [
      {
        "name": "Hans"
      },
      {
        "name": "Lennard Hofmann"
      }
    ],
    "links": {
      "repository": "https://github.com/Ordoviz/tree-sitter-csv"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
